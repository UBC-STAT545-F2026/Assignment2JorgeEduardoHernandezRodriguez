library(devtools)
document()
grouped_main_stats <- function(data, grouping_var, num_var, na.rm=TRUE) {
# Making the function to stop if the
if(!is.factor(pull(data, {{grouping_var}}))){ # need to pull th
stop("`grouping_var` must be categorical ")
}
if(!is.numeric(pull(data, {{num_var}}))){
stop("`num_var` must be numerical ")
}
if(!is.logical(na.rm)){
stop("`na.rm` must be logical (TRUE or FALSE)")
}
summary <- data|> # making data set as first argument of the next
group_by({{grouping_var}})|> # grouping by the categorical variable
# Making the summary table with mean, median, min and max
summarize("mean_{{num_var}}" := mean({{num_var}}, na.rm=na.rm), #AI was used here to make the title of each variable in the table since the paste function I originally used was producing an error, since I want to use mean + title of the numerical variable
"median_{{num_var}}" := median({{num_var}}, na.rm=na.rm),
"min_{{num_var}}" := min({{num_var}}, na.rm=na.rm),
"max_{{num_var}}" := max({{num_var}}, na.rm=na.rm))
# making another output for making the histogram plot to show the distribution
plot <- data|>
ggplot(aes(x={{num_var}}, fill = {{grouping_var}}))+
geom_histogram()
print(summary)
print(plot)
}
